#!/bin/sh
# Valida que el mensaje de commit siga Conventional Commits.
# Se activa con:  git config core.hooksPath .githooks   (lo hace scripts/setup.py)

first_line=$(head -n 1 "$1")

# Commits generados por git (merge, revert, fixup/squash) se aceptan tal cual
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|refactor|perf|test|docs|style|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo ""
  echo "  ✖ Mensaje de commit inválido:"
  echo "      $first_line"
  echo ""
  echo "  Formato:  tipo(alcance): descripción"
  echo "  Tipos:    feat fix refactor perf test docs style build ci chore revert"
  echo "  Ejemplo:  feat(backend): add PlanRoutes use case"
  echo ""
  echo "  Ver CONTRIBUTING.md"
  exit 1
fi
