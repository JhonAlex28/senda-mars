# Carpeta con targets_v0.geojson y env.json (relativa a backend/)
SENDA_DATA_DIR=./data
# Orígenes permitidos para CORS (separados por coma)
SENDA_CORS_ORIGINS=http://localhost:5173
# Máximo de celdas por grilla para planificar; si el DEM es mayor se submuestrea (doc §6.3)
SENDA_MAX_PLANNING_CELLS=300000
# Asistente de IA local con Ollama (opcional; en Render dejarlo desactivado)
# SENDA_ASSISTANT_ENABLED=true
# SENDA_LLM_MODEL=qwen3:1.7b
# SENDA_OLLAMA_URL=http://localhost:11434
# SENDA_LLM_CONTEXT_TOKENS=8192
# Solo si el servidor Ollama es remoto y privado (token de Hugging Face, NUNCA en git)
# SENDA_OLLAMA_TOKEN=

# IBM Quantum (opcional, panel Quantum Lab). Solo en el servidor; NUNCA en git ni en el frontend.
# Sin token se usa el simulador local Qiskit Aer (pip install -e .[quantum]).
# IBM_QUANTUM_TOKEN=
# IBM_QUANTUM_INSTANCE=
